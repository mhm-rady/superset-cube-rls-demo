# Copy this file to .env and fill in real secrets before running `docker compose up`.
# .env is gitignored -- never commit real secrets.
#
# Generate random secrets with:  openssl rand -base64 42
# (Git Bash / WSL have openssl; on plain PowerShell use:
#   [Convert]::ToBase64String((1..42 | ForEach-Object { Get-Random -Max 256 }))  )

# ============================================================================
# Superset metadata database (Postgres) + cache/broker (Redis)
#
# DATABASE_*/REDIS_* are read by superset/superset_config_docker.py (this
# project's own config -- see its header comment for why it has to build
# the metadata SQLALCHEMY_DATABASE_URI itself). ADMIN_PASSWORD/PYTHONPATH/
# SUPERSET_LOAD_EXAMPLES/etc are read directly by the official image's own
# docker/docker-init.sh and docker-bootstrap.sh -- do not rename those.
# ============================================================================
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset

DATABASE_DIALECT=postgresql
DATABASE_HOST=superset-db
DATABASE_PORT=5432
DATABASE_DB=superset
DATABASE_USER=superset
DATABASE_PASSWORD=superset

# The base image's superset_config.py always builds an "examples" connection
# string even though we never load example data (SUPERSET_LOAD_EXAMPLES=no).
# Point it at the same Postgres so it's at least a valid, harmless URI.
EXAMPLES_DB=superset
EXAMPLES_HOST=superset-db
EXAMPLES_PORT=5432
EXAMPLES_USER=superset
EXAMPLES_PASSWORD=superset

REDIS_HOST=superset-redis
REDIS_PORT=6379

SUPERSET_LOAD_EXAMPLES=no
SUPERSET_APP_ROOT=/
SUPERSET_ENV=development
SUPERSET_LOG_LEVEL=info
SUPERSET_PORT=8088
CYPRESS_CONFIG=false
FLASK_DEBUG=true

# docker-init.sh hardcodes the admin username to "admin" and email to
# admin@superset.com -- only the password is configurable. This is not
# incidental to the demo: see personas.json's "admin" persona and
# backend/server.js's note on why the Superset operator login and the
# "sees everything" demo persona are deliberately the same name.
ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=changeme-generate-with-openssl-rand-base64-42

# Guest-token signing secret for embedded dashboards. 6.1.0 ships a public
# default with no startup guard against it -- always set a real value.
GUEST_TOKEN_JWT_SECRET=changeme-generate-with-openssl-rand-base64-42

# Written automatically by scripts/bootstrap.mjs after it enables embedding
# on the demo dashboard. Leave blank initially.
SUPERSET_EMBED_DASHBOARD_UUID=

# ============================================================================
# Cube
# ============================================================================
CUBEJS_API_SECRET=changeme-generate-with-openssl-rand-base64-42

# SQL Server, containerized (see the `mssql` and `mssql-init` services in
# docker-compose.yml, and README "Data source").
#
# MSSQL_SA_PASSWORD must satisfy Microsoft's image's complexity check at
# container startup (8+ chars from at least 3 of: upper, lower, digit,
# symbol) or the container refuses to start -- `openssl rand -base64 24`
# satisfies it; a hex-only generator will NOT.
MSSQL_SA_PASSWORD=changeme-generate-with-openssl-rand-base64-24

# CUBEJS_DB_PASS is the password mssql-init creates the cube_reader login
# with -- set it here yourself (openssl rand -hex 24) rather than letting
# anything default it. CHECK_POLICY is off for this login (it's a
# compose-network-only least-privilege account, not SA), so unlike
# MSSQL_SA_PASSWORD, complexity isn't enforced -- but still don't leave the
# placeholder in place.
CUBEJS_DB_HOST=mssql
CUBEJS_DB_PORT=1433
CUBEJS_DB_NAME=AdventureWorksDW
CUBEJS_DB_USER=cube_reader
CUBEJS_DB_PASS=changeme-generate-with-openssl-rand-hex-24

# Cube's Postgres-wire SQL API, used by Superset and by the backend's
# /api/explain endpoint. There is no default port in Cube itself -- omitting
# CUBEJS_PG_SQL_PORT silently disables the SQL API entirely.
CUBEJS_PG_SQL_PORT=15432

# The ONE shared secret every persona's SQL API connection authenticates
# with. This is safe specifically because cube/cube.js's checkSqlAuth carries
# each end user's identity in the *username*, not the password -- see the
# comment there before assuming a shared password is a shortcut.
#
# Must be URL-safe: scripts/bootstrap.mjs embeds this directly in a Postgres
# connection URI (postgresql+psycopg2://user:PASSWORD@cube:port/cube), not
# through a library that would percent-encode it -- a raw `openssl rand
# -base64` value can contain `/` or `+` and silently break URI parsing. Use
# `openssl rand -hex 24` (or similar alphanumeric-only generator) instead.
CUBE_SQL_SHARED_PASSWORD=changeme-shared-cube-sql-secret

# ============================================================================
# Cross-service wiring
# ============================================================================
# Reached by the backend container over the internal compose network.
SUPERSET_INTERNAL_URL=http://superset:8088
# Reached by the browser -- the embedded SDK talks to Superset directly.
SUPERSET_PUBLIC_URL=http://localhost:8088

FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=3001
